{% extends "layout.twig" %}

{% block title %} Detalles de canción {% endblock %}

{% block main_container %}
	 <div class="row">
		<div class="media col-xs-10">
		  <div class="media-left media-middle">
			<img class="media-object" src="/covers/{{ song._id }}.png" >
		  </div>
		  <div class="media-body">
			 <h2>{{ song.title }}</h2>
			 <p>{{ song.author }}</p>
			 <p>{{ song.kind }}</p>
			 <button type="button" class="btn btn-primary pull-right">{{ song.price}}€</button>
			 <!-- Cambiar el precio por "reproducir" si ya está comprada -->
			  <h2> Comentarios</h2>
			  <form class="form-horizontal" method="post" action="/comments/add/{{ song._id }}">
				  <div class="form-group">
					  <label class="control-label col-sm-2" for="text">Comentario:</label>
					  <div class="col-sm-10">
						  <input id="text" type="text" class="form-control" name="text"
								 placeholder="Escribe el texto del comentario" required="true"
								 value="{{ comment.text }}" />
					  </div>
				  </div>
				  <div class="form-group">
					  <div class="col-sm-offset-2 col-sm-10">
						  <button type="submit" class="btn btn-primary">Publicar Comentario</button>
					  </div>
				  </div>
			  </form>
		  </div>
			  <table class="table table-hover">
				  <thead>
				  <tr>
					  <th>Usuario</th>
					  <th>Texto</th>
					  <th class="col-md-1"></th>
				  </tr>
				  </thead>
				  <tbody>
				  {% for comment in comments %}
					  <tr>
						  <td>{{ comment.author }}</td>
						  <td>{{ comment.text }}</td>
						  <td><a href="/comments/delete/{{ comemnt._id }}">Eliminar comentario</a></td>
					  </tr>
				  {% endfor %}
				  </tbody>
			  </table>
		  </div>
	  </div>
	  
